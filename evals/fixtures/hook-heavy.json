  {"start":40.3,"end":44.943,"text":"Most people think the answer is more process, and that is exactly backwards.","words":[{"text":"Most","start":40.3,"end":40.629,"probability":0.96},{"text":"people","start":40.657,"end":40.986,"probability":0.96},{"text":"think","start":41.014,"end":41.343,"probability":0.96},{"text":"the","start":41.371,"end":41.7,"probability":0.96},{"text":"answer","start":41.729,"end":42.057,"probability":0.96},{"text":"is","start":42.086,"end":42.414,"probability":0.96},{"text":"more","start":42.443,"end":42.771,"probability":0.96},{"text":"process,","start":42.8,"end":43.129,"probability":0.96},{"text":"and","start":43.157,"end":43.486,"probability":0.96},{"text":"that","start":43.514,"end":43.843,"probability":0.96},{"text":"is","start":43.871,"end":44.2,"probability":0.96},{"text":"exactly","start":44.229,"end":44.557,"probability":0.96},{"text":"backwards.","start":44.586,"end":44.914,"probability":0.96}]},
  {"start":45.293,"end":50.293,"text":"Process is what you add when you do not trust the people you hired.","words":[{"text":"Process","start":45.293,"end":45.621,"probability":0.96},{"text":"is","start":45.65,"end":45.979,"probability":0.96},{"text":"what","start":46.007,"end":46.336,"probability":0.96},{"text":"you","start":46.364,"end":46.693,"probability":0.96},{"text":"add","start":46.721,"end":47.05,"probability":0.96},{"text":"when","start":47.079,"end":47.407,"probability":0.96},{"text":"you","start":47.436,"end":47.764,"probability":0.96},{"text":"do","start":47.793,"end":48.121,"probability":0.96},{"text":"not","start":48.15,"end":48.479,"probability":0.96},{"text":"trust","start":48.507,"end":48.836,"probability":0.96},{"text":"the","start":48.864,"end":49.193,"probability":0.96},{"text":"people","start":49.221,"end":49.55,"probability":0.96},{"text":"you","start":49.579,"end":49.907,"probability":0.96},{"text":"hired.","start":49.936,"end":50.264,"probability":0.96}]},
  {"start":50.643,"end":55.643,"text":"If you hire well, the process can stay small and the team stays fast.","words":[{"text":"If","start":50.643,"end":50.971,"probability":0.96},{"text":"you","start":51.0,"end":51.329,"probability":0.96},{"text":"hire","start":51.357,"end":51.686,"probability":0.96},{"text":"well,","start":51.714,"end":52.043,"probability":0.96},{"text":"the","start":52.071,"end":52.4,"probability":0.96},{"text":"process","start":52.429,"end":52.757,"probability":0.96},{"text":"can","start":52.786,"end":53.114,"probability":0.96},{"text":"stay","start":53.143,"end":53.471,"probability":0.96},{"text":"small","start":53.5,"end":53.829,"probability":0.96},{"text":"and","start":53.857,"end":54.186,"probability":0.96},{"text":"the","start":54.214,"end":54.543,"probability":0.96},{"text":"team","start":54.571,"end":54.9,"probability":0.96},{"text":"stays","start":54.929,"end":55.257,"probability":0.96},{"text":"fast.","start":55.286,"end":55.614,"probability":0.96}]},
