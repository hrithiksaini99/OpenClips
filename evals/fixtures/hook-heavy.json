{
 "language": "en",
 "duration": 137.314,
 "segments": [
  {"start":0.0,"end":5.357,"text":"Welcome back to the show, today we are talking about why good products still fail.","words":[{"text":"Welcome","start":0.0,"end":0.329,"probability":0.96},{"text":"back","start":0.357,"end":0.686,"probability":0.96},{"text":"to","start":0.714,"end":1.043,"probability":0.96},{"text":"the","start":1.071,"end":1.4,"probability":0.96},{"text":"show,","start":1.429,"end":1.757,"probability":0.96},{"text":"today","start":1.786,"end":2.114,"probability":0.96},{"text":"we","start":2.143,"end":2.471,"probability":0.96},{"text":"are","start":2.5,"end":2.829,"probability":0.96},{"text":"talking","start":2.857,"end":3.186,"probability":0.96},{"text":"about","start":3.214,"end":3.543,"probability":0.96},{"text":"why","start":3.571,"end":3.9,"probability":0.96},{"text":"good","start":3.929,"end":4.257,"probability":0.96},{"text":"products","start":4.286,"end":4.614,"probability":0.96},{"text":"still","start":4.643,"end":4.971,"probability":0.96},{"text":"fail.","start":5.0,"end":5.329,"probability":0.96}]},
  {"start":5.707,"end":11.064,"text":"I spent the last three years watching early stage teams make the same expensive mistakes.","words":[{"text":"I","start":5.707,"end":6.036,"probability":0.96},{"text":"spent","start":6.064,"end":6.393,"probability":0.96},{"text":"the","start":6.421,"end":6.75,"probability":0.96},{"text":"last","start":6.779,"end":7.107,"probability":0.96},{"text":"three","start":7.136,"end":7.464,"probability":0.96},{"text":"years","start":7.493,"end":7.821,"probability":0.96},{"text":"watching","start":7.85,"end":8.179,"probability":0.96},{"text":"early","start":8.207,"end":8.536,"probability":0.96},{"text":"stage","start":8.564,"end":8.893,"probability":0.96},{"text":"teams","start":8.921,"end":9.25,"probability":0.96},{"text":"make","start":9.279,"end":9.607,"probability":0.96},{"text":"the","start":9.636,"end":9.964,"probability":0.96},{"text":"same","start":9.993,"end":10.321,"probability":0.96},{"text":"expensive","start":10.35,"end":10.679,"probability":0.96},{"text":"mistakes.","start":10.707,"end":11.036,"probability":0.96}]},
  {"start":11.414,"end":16.414,"text":"The biggest mistake founders make is hiring for passion instead of proof of work.","words":[{"text":"The","start":11.414,"end":11.743,"probability":0.96},{"text":"biggest","start":11.771,"end":12.1,"probability":0.96},{"text":"mistake","start":12.129,"end":12.457,"probability":0.96},{"text":"founders","start":12.486,"end":12.814,"probability":0.96},{"text":"make","start":12.843,"end":13.171,"probability":0.96},{"text":"is","start":13.2,"end":13.529,"probability":0.96},{"text":"hiring","start":13.557,"end":13.886,"probability":0.96},{"text":"for","start":13.914,"end":14.243,"probability":0.96},{"text":"passion","start":14.271,"end":14.6,"probability":0.96},{"text":"instead","start":14.629,"end":14.957,"probability":0.96},{"text":"of","start":14.986,"end":15.314,"probability":0.96},{"text":"proof","start":15.343,"end":15.671,"probability":0.96},{"text":"of","start":15.7,"end":16.029,"probability":0.96},{"text":"work.","start":16.057,"end":16.386,"probability":0.96}]},
  {"start":16.764,"end":21.05,"text":"That single decision quietly destroys more companies than bad pricing ever will.","words":[{"text":"That","start":16.764,"end":17.093,"probability":0.96},{"text":"single","start":17.121,"end":17.45,"probability":0.96},{"text":"decision","start":17.479,"end":17.807,"probability":0.96},{"text":"quietly","start":17.836,"end":18.164,"probability":0.96},{"text":"destroys","start":18.193,"end":18.521,"probability":0.96},{"text":"more","start":18.55,"end":18.879,"probability":0.96},{"text":"companies","start":18.907,"end":19.236,"probability":0.96},{"text":"than","start":19.264,"end":19.593,"probability":0.96},{"text":"bad","start":19.621,"end":19.95,"probability":0.96},{"text":"pricing","start":19.979,"end":20.307,"probability":0.96},{"text":"ever","start":20.336,"end":20.664,"probability":0.96},{"text":"will.","start":20.693,"end":21.021,"probability":0.96}]},
  {"start":21.4,"end":26.043,"text":"Here is the thing about hiring, you cannot interview your way to certainty.","words":[{"text":"Here","start":21.4,"end":21.729,"probability":0.96},{"text":"is","start":21.757,"end":22.086,"probability":0.96},{"text":"the","start":22.114,"end":22.443,"probability":0.96},{"text":"thing","start":22.471,"end":22.8,"probability":0.96},{"text":"about","start":22.829,"end":23.157,"probability":0.96},{"text":"hiring,","start":23.186,"end":23.514,"probability":0.96},{"text":"you","start":23.543,"end":23.871,"probability":0.96},{"text":"cannot","start":23.9,"end":24.229,"probability":0.96},{"text":"interview","start":24.257,"end":24.586,"probability":0.96},{"text":"your","start":24.614,"end":24.943,"probability":0.96},{"text":"way","start":24.971,"end":25.3,"probability":0.96},{"text":"to","start":25.329,"end":25.657,"probability":0.96},{"text":"certainty.","start":25.686,"end":26.014,"probability":0.96}]},
  {"start":26.393,"end":30.321,"text":"You can only watch what someone has already shipped under pressure.","words":[{"text":"You","start":26.393,"end":26.721,"probability":0.96},{"text":"can","start":26.75,"end":27.079,"probability":0.96},{"text":"only","start":27.107,"end":27.436,"probability":0.96},{"text":"watch","start":27.464,"end":27.793,"probability":0.96},{"text":"what","start":27.821,"end":28.15,"probability":0.96},{"text":"someone","start":28.179,"end":28.507,"probability":0.96},{"text":"has","start":28.536,"end":28.864,"probability":0.96},{"text":"already","start":28.893,"end":29.221,"probability":0.96},{"text":"shipped","start":29.25,"end":29.579,"probability":0.96},{"text":"under","start":29.607,"end":29.936,"probability":0.96},{"text":"pressure.","start":29.964,"end":30.293,"probability":0.96}]},
  {"start":30.671,"end":35.314,"text":"So we started asking every candidate for one artifact and one failure story.","words":[{"text":"So","start":30.671,"end":31.0,"probability":0.96},{"text":"we","start":31.029,"end":31.357,"probability":0.96},{"text":"started","start":31.386,"end":31.714,"probability":0.96},{"text":"asking","start":31.743,"end":32.071,"probability":0.96},{"text":"every","start":32.1,"end":32.429,"probability":0.96},{"text":"candidate","start":32.457,"end":32.786,"probability":0.96},{"text":"for","start":32.814,"end":33.143,"probability":0.96},{"text":"one","start":33.171,"end":33.5,"probability":0.96},{"text":"artifact","start":33.529,"end":33.857,"probability":0.96},{"text":"and","start":33.886,"end":34.214,"probability":0.96},{"text":"one","start":34.243,"end":34.571,"probability":0.96},{"text":"failure","start":34.6,"end":34.929,"probability":0.96},{"text":"story.","start":34.957,"end":35.286,"probability":0.96}]},
