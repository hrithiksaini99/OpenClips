OPENCLIPS_DATABASE_URL=postgresql+psycopg://openclips:openclips@db:5432/openclips
OPENCLIPS_REDIS_URL=redis://redis:6379/0
OPENCLIPS_MEDIA_ROOT=/data/media
OPENCLIPS_MODEL_CACHE_ROOT=/root/.cache/huggingface/hub
OPENCLIPS_MAX_UPLOAD_BYTES=10737418240
OPENCLIPS_WORKER_CONCURRENCY=2
OPENCLIPS_MAX_CONCURRENT_TRANSCRIPTIONS=1
OPENCLIPS_MAX_CONCURRENT_RENDERS=1
OPENCLIPS_OUTBOX_BATCH_SIZE=50
OPENCLIPS_OUTBOX_BACKOFF_CAP_SECONDS=300
OPENCLIPS_TRANSCRIPTION_MODEL_SIZE=base
OPENCLIPS_TRANSCRIPTION_DEVICE=cpu
OPENCLIPS_TRANSCRIPTION_COMPUTE_TYPE=int8
OPENCLIPS_API_HOST=0.0.0.0
OPENCLIPS_API_PORT=8000
OPENCLIPS_ADMIN_TOKEN=change-me
OPENCLIPS_INSTAGRAM_ACCOUNT_ID=
OPENCLIPS_INSTAGRAM_ACCESS_TOKEN=
OPENCLIPS_YOUTUBE_ACCESS_TOKEN=
OPENCLIPS_LOG_LEVEL=INFO
